# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=super-secret-expense-key-2026

# Database Configuration (MySQL / SQLite)
# Set DB_TYPE to 'mysql' or 'sqlite' (defaults to mysql with auto-sqlite fallback)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ai_expense_visualizer

# Optional: Google Gemini API Key for Advanced AI Insights, Chatbot & Receipt Vision
# If not provided, the built-in intelligent statistical engine handles all analysis locally.
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
