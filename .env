# ============================================================================
# AI EXPENSE VISUALIZER - ENVIRONMENT CONFIGURATION (.env)
# ============================================================================

# Flask Secret Key for Sessions
SECRET_KEY=super-secret-ai-expense-key-2026

# Public Canonical Site URL (Used for SEO, Google Search Console, Sitemap, Canonical Tags)
SITE_URL=https://expense-visualizer-app.onrender.com

# Google Search Console Verification ID (Optional: e.g. google-site-verification=abc123xyz)
GOOGLE_SITE_VERIFICATION=

# Database Configuration (Defaults to MySQL if running, fallback to SQLite)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_expense_db
DB_PORT=3306
